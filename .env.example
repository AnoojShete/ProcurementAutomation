# Environment. Services default to PRODUCTION rules when this is unset:
# they refuse to start with the published default secrets (JWT_SECRET,
# ESIGN_WEBHOOK_SECRET, MinIO password), don't seed demo accounts, and turn
# off simulated e-signing and showcase scenarios. The demo compose stack
# sets APP_ENV=development for you.
# APP_ENV=production
# SEED_DEMO_USERS=true   # force demo accounts outside development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
REDPANDA_BROKERS=redpanda:9092
NETWORK_NAME=it-procurement-network

# Platform-wide auth (shared/auth) — every service verifying tokens and
# auth-service issuing them must use the SAME secret. Change this for any
# real deployment; the checked-in default is for local dev only.
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7
AUTH_SERVICE_URL=http://auth-service:8005

# E-signature webhook (contract-risk-agent POST /webhooks/esign)
ESIGN_WEBHOOK_SECRET=dev-esign-secret-change-me

# Business rules internal service auth (auth-service GET /internal/business-rules)
RULES_ENGINE_INTERNAL_SECRET=dev-rules-secret-change-me

# GSTIN live registry (document-vendor-agent, Prompt 1).
# gstincheck.co.in free tier: ~20 lookups TOTAL (not per-day).
# Gated by shared/live_mode quota -- leave live_verification_enabled=FALSE
# in system_settings during dev/test. Only enable on demo day.
GSTINCHECK_API_KEY=your_gstincheck_api_key_here
OPENCORPORATES_API_TOKEN=your_opencorporates_api_token_here
GUARDIAN_API_KEY=your_guardian_api_key_here

# ---- Account emails (sign-up confirmation, password reset) — shared/mailer.py
# EMAIL_MODE=dev   Mailpit, the local mail catcher: nothing leaves your
#                  machine; read the mail at http://localhost:8025.
# EMAIL_MODE=smtp  Real delivery through any SMTP provider. Refused unless
#                  host, username, password and TLS are all set.
#
# Gmail (free, ~500 mails/day — fine for a student project):
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an app password: https://myaccount.google.com/apppasswords
#   3. EMAIL_MODE=smtp, SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#      SMTP_SECURITY=starttls, SMTP_USERNAME=<you>@gmail.com,
#      SMTP_PASSWORD=<16-character app password, no spaces>,
#      EMAIL_FROM="Procurement Platform <<you>@gmail.com>"  (Gmail rewrites
#      any other From address)
# Other providers take the same settings: Brevo smtp-relay.brevo.com:587,
# Resend smtp.resend.com:465 (ssl, username "resend", API key as password),
# SendGrid smtp.sendgrid.net:587 (username "apikey").
#
# Put real values in .env (git-ignored), never in this file.
# Leave SMTP_HOST / SMTP_PORT / SMTP_SECURITY blank for EMAIL_MODE=dev (they
# default to Mailpit). With EMAIL_MODE=smtp they default to port 587 + starttls.
EMAIL_MODE=dev
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Procurement Platform <noreply@procurement.local>
EMAIL_REPLY_TO=
# Where links in emails point: the address people open the app at.
APP_BASE_URL=http://localhost:8080

# Login lockout: this many wrong passwords within the window locks the
# address for AUTH_LOCKOUT_MINUTES.
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_WINDOW_MINUTES=15
# AUTH_LOCKOUT_MINUTES=15

# Documenso (optional). With these set, "Send for signature" uploads the
# contract PDF to Documenso and emails the signer; point a Documenso webhook
# (event DOCUMENT_COMPLETED) at /api/webhooks/documenso with the same secret.
# Unset = signing is simulated (demo default).
# APP_DOCUMENSO_API_URL=http://documenso:3000
# APP_DOCUMENSO_API_TOKEN=
# APP_DOCUMENSO_WEBHOOK_SECRET=

# Kafka logins (per service) — see infra/redpanda/acls.conf. The demo
# compose falls back to dev-kafka-<service>, which is refused outside
# development.
# KAFKA_ADMIN_PASSWORD=
# KAFKA_PASSWORD_DOCUMENT_VENDOR_AGENT=
# KAFKA_PASSWORD_APPROVAL_INVENTORY_AGENT=
# KAFKA_PASSWORD_CONTRACT_RISK_AGENT=
# KAFKA_PASSWORD_NOTIFICATION_AGENT=
# KAFKA_PASSWORD_AUTH_SERVICE=
# KAFKA_PASSWORD_KAFKA_EXPORTER=

# Session cookies: Secure flag (on by default outside development). Turn on
# once the gateway is served over HTTPS.
# AUTH_COOKIE_SECURE=true
