POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
REDPANDA_BROKERS=redpanda:9092
NETWORK_NAME=it-procurement-network

# Platform-wide auth (shared/auth) — every service verifying tokens and
# auth-service issuing them must use the SAME secret. Change this for any
# real deployment; the checked-in default is for local dev only.
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7
AUTH_SERVICE_URL=http://auth-service:8005

# E-signature webhook (contract-risk-agent POST /webhooks/esign)
ESIGN_WEBHOOK_SECRET=dev-esign-secret-change-me

# GSTIN live registry (document-vendor-agent, Prompt 1).
# gstincheck.co.in free tier: ~20 lookups TOTAL (not per-day).
# Gated by shared/live_mode quota -- leave live_verification_enabled=FALSE
# in system_settings during dev/test. Only enable on demo day.
GSTINCHECK_API_KEY=your_gstincheck_api_key_here
