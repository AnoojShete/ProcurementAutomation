# ==========================================
# Application Environment
# ==========================================
# Set to 'development' for local testing; 'production' enforces strict secrets
APP_ENV=development
SEED_DEMO_USERS=true

# Database & Object Storage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ==========================================
# Authentication & Internal Services
# ==========================================
# Platform-wide auth (shared/auth) — replace for real deployments
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# E-signature webhook & rules engine secrets
ESIGN_WEBHOOK_SECRET=dev-esign-secret-change-me
RULES_ENGINE_INTERNAL_SECRET=dev-rules-secret-change-me
# Key used to derive AES-256-GCM encryption key for stored company SMTP passwords
SMTP_ENCRYPTION_SECRET=dev-smtp-secret-change-me

# ==========================================
# External Vendor Verification APIs
# ==========================================
# GSTIN check: https://gstincheck.co.in (free tier ~20 lookups)
GSTINCHECK_API_KEY=your_gstincheck_api_key_here
# Adverse-media check (vendor risk, live mode): free developer key from
# https://open-platform.theguardian.com/access/ . Unset = not assessed.
GUARDIAN_API_KEY=
# Documents one document worker processes at once (PERF-1, Oct 29: 8 was no
# faster than 4 on 15 CPUs; add a worker replica instead).
APP_WORKER_CONCURRENCY=4
# E-invoice QR checks (GST, Phase 4): the Invoice Registration Portal's public
# key, PEM text in quotes. Unset in development = the demo key (never trusted
# in production, where QRs then show as "not verified").
# EINVOICE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"


# ==========================================
# Email Configuration (shared/mailer.py)
# ==========================================
# EMAIL_MODE=dev   -> Routes to local Mailpit catcher (http://localhost:8025)
# EMAIL_MODE=smtp  -> Real delivery (Gmail, Brevo, Resend, SendGrid)
EMAIL_MODE=dev

# SMTP settings — only for EMAIL_MODE=smtp. Leave them commented out in
# dev mode: when set, they override the Mailpit defaults, and a fresh
# clone's account emails went to Gmail with placeholder credentials.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=your_email@example.com
# SMTP_PASSWORD=your_smtp_app_password_or_key_here

# Sender header addresses
EMAIL_FROM=Procurement Platform <noreply@procurement.local>
EMAIL_REPLY_TO=noreply@procurement.local

# Frontend / app link base URL
APP_BASE_URL=http://localhost:8080

# ==========================================
# Email intake (documents sent to a mailbox → document pipeline)
# ==========================================
# Defaults read Mailpit's POP3 mailbox in development. For a real mailbox
# set the host, protocol (pop3 | imap), port, SSL and login.
# EMAIL_INTAKE_ENABLED=true
# EMAIL_INTAKE_PROTOCOL=pop3
# EMAIL_INTAKE_HOST=mailpit
# EMAIL_INTAKE_PORT=1110
# EMAIL_INTAKE_SSL=false
# EMAIL_INTAKE_USER=intake
# EMAIL_INTAKE_PASSWORD=dev-intake-password
# EMAIL_INTAKE_ADDRESS=invoices@procurement.local

# ==========================================
# Security & Auth Lockout
# ==========================================
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15
AUTH_COOKIE_SECURE=false

# ==========================================
# Optional Integrations (Unset = Simulated)
# ==========================================
# Documenso (contract e-signature, the `documenso` service). Both parties
# sign in its embedded frame on the platform's pages. Run once:
#   python scripts/documenso_setup.py
# It makes the signing certificate (secrets/documenso/cert.p12), the
# account, API token and webhook, and writes the last three lines below.
# Without a token, contracts are signed with the built-in e-sign.
# APP_DOCUMENSO_API_URL=http://documenso:3000
# Where browsers load the signing frame from (also allowed in nginx's CSP).
# DOCUMENSO_PUBLIC_URL=http://localhost:3010
# Change all four for a real deployment (the defaults are published):
# DOCUMENSO_NEXTAUTH_SECRET=
# DOCUMENSO_ENCRYPTION_KEY=
# DOCUMENSO_ENCRYPTION_SECONDARY_KEY=
# DOCUMENSO_SIGNING_PASSPHRASE=
# true once the setup script has made the platform's account.
# DOCUMENSO_DISABLE_SIGNUP=false
# APP_DOCUMENSO_API_TOKEN=
# APP_DOCUMENSO_WEBHOOK_SECRET=
# DOCUMENSO_ADMIN_PASSWORD=

# DocuSign Sandbox
# APP_DOCUSIGN_INTEGRATION_KEY=
# APP_DOCUSIGN_USER_ID=
# APP_DOCUSIGN_ACCOUNT_ID=
# APP_DOCUSIGN_PRIVATE_KEY_FILE=/run/secrets/app/docusign_private.key
# APP_DOCUSIGN_PRIVATE_KEY=          # the key itself, instead of the file
# APP_DOCUSIGN_AUTH_SERVER=account-d.docusign.com
# APP_DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
# APP_DOCUSIGN_CONNECT_HMAC_KEY=

# Inbox Drop Folder Auto-Signer
# APP_ESIGN_AUTO_SIGNER_EMAIL=signer@example.com
# APP_ESIGN_AUTO_SIGNER_NAME=Authorized Signer
# APP_ESIGN_AUTO_SEND=true

# Kafka Service Logins (production)
# KAFKA_ADMIN_PASSWORD=
# KAFKA_PASSWORD_DOCUMENT_VENDOR_AGENT=
# KAFKA_PASSWORD_APPROVAL_INVENTORY_AGENT=
# KAFKA_PASSWORD_CONTRACT_RISK_AGENT=
# KAFKA_PASSWORD_EVENT_MONITOR=
# KAFKA_PASSWORD_NOTIFICATION_AGENT=
# KAFKA_PASSWORD_AUTH_SERVICE=
# KAFKA_PASSWORD_KAFKA_EXPORTER=

# ==========================================
# Email-Based Actions & Signing (Prompt 8)
# ==========================================
# Token notification-agent uses to get email-action links from
# approval-inventory-agent (internal network only). Change it for any
# shared deployment.
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-change-me
# Base URL put in emailed links; unset = APP_BASE_URL.
PUBLIC_BASE_URL=http://localhost:8080
# Demo-only "simulate signature" endpoint.
ENABLE_SIGN_SIMULATED=false

# Chatbot Agent (Ollama LLM). Default: Ollama on this machine
# (`brew install ollama && brew services start ollama`), reached from the
# containers as http://host.docker.internal:11434. Set the URL only for an
# Ollama on another machine. Model must support tool calling:
# llama3.2:3b (2 GB, smallest that works) or llama3.1 (4.9 GB, better at
# chaining tools). Pull it first: `ollama pull llama3.2:3b`.
# LLM_API_BASE_URL=http://<IP_OF_YOUR_EXTERNAL_MACHINE>:11434
LLM_MODEL_NAME=llama3.2:3b